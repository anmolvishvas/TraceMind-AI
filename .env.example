# ==============================================================================
# TraceMind AI — Environment Configuration Template
# ==============================================================================

# Application Runtime Environment: development | staging | production | test
ENVIRONMENT=development
DEBUG=true

# PostgreSQL + pgvector Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tracemind
POSTGRES_PASSWORD=tracemind_secret
POSTGRES_DB=tracemind_db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis Cache & Broker Configuration
REDIS_URL=redis://localhost:6379/0

# Model Context Protocol (MCP) Bearer API Key
MCP_API_KEY=tracemind-mcp-default-key

# OpenAI API Configuration (Optional: mock engine activates if placeholder)
OPENAI_API_KEY=sk-placeholder-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
